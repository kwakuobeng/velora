{
  "meta": {
    "brand": "Velora",
    "direction": "Fieldhand adaptation",
    "reference": "https://fieldhand.modulify.website/",
    "version": "1.0"
  },
  "color": {
    "forest": "#2D5F3F",
    "forestPress": "#244d33",
    "limestone": "#E8DFD0",
    "oak": "#1A2E22",
    "offWhite": "#F7F5F2",
    "white": "#FFFFFF",
    "muted": "#5F6B63",
    "sage": "#A8BC9E",
    "mist": "#E8EEE9",
    "hairline": "rgba(26, 46, 34, 0.08)",
    "exampleLabel": "#8A7B5C"
  },
  "type": {
    "display": {
      "family": "Instrument Sans, Inter, system-ui, sans-serif",
      "files": ["InstrumentSans-Variable.ttf", "InstrumentSans-Italic-Variable.ttf"],
      "license": "OFL (Google Fonts)",
      "h1": { "weight": 500, "sizeRem": [2.75, 4.15], "tracking": "-0.035em", "lineHeight": 1.08 },
      "h2": { "weight": 500, "sizeRem": [1.85, 2.5], "tracking": "-0.03em", "lineHeight": 1.12 },
      "price": { "weight": 600, "sizeRem": 3.75, "tracking": "-0.04em", "variantNumeric": "tabular-nums" },
      "accentItalic": { "style": "italic", "weight": 500, "color": "forest" }
    },
    "ui": {
      "family": "Inter, -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
      "files": ["Inter-Variable.ttf"],
      "body": { "weight": 400, "sizePx": 16, "tracking": "0" },
      "label": { "weight": 600, "sizePx": 11, "tracking": "0.05em", "transform": "uppercase" },
      "button": { "weight": 600, "sizePx": 17 }
    }
  },
  "radius": {
    "card": "22px",
    "chip": "14px",
    "pill": "999px",
    "nav": "999px"
  },
  "spacing": {
    "grid": 8,
    "sectionY": { "desktop": 72, "mobile": 48 },
    "gutter": { "desktop": 24, "mobile": 16 },
    "cardPad": 18
  },
  "shadow": {
    "soft": "0 10px 40px rgba(26,46,34,0.08), 0 2px 8px rgba(26,46,34,0.04)",
    "lg": "0 24px 60px rgba(26,46,34,0.12), 0 4px 16px rgba(26,46,34,0.06)",
    "cta": "0 6px 20px rgba(45,95,63,0.28)"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "fastMs": 150,
    "sectionFadeMs": 500,
    "hover": "background-color 150ms ease"
  },
  "components": {
    "primaryCtaLabel": "Get Quote",
    "appPrimaryCtaLabel": "Approve & schedule",
    "priceMustBeLoudest": true,
    "examplePricingLabel": "Example pricing"
  }
}
